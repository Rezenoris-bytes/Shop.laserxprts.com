# ============================================================================
# LEI Platform — environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# Every variable here is validated at boot; the app refuses to start if a
# required one is missing or malformed.
# ============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── DEMO MODE ───────────────────────────────────────────────────────────────
# true  = staging/demo. Blocks indexing, shows the sample-data banner,
#         watermarks quote PDFs.
# false = production. Boot FAILS if any seed data or PLACEHOLDER setting
#         still exists in the database.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ── Domain ──────────────────────────────────────────────────────────────────
# The production domain is deferred. Nothing in the codebase hardcodes a
# hostname — changing these three values plus DNS/TLS moves the whole app.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── Ports ───────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
# PORT: set by some hosts (e.g. Hostinger Passenger) at runtime — main.ts and
# apps/web/server.js both prefer this over API_PORT/WEB_PORT when present.
# Leave unset for local dev.
# PORT=

# ── Database ────────────────────────────────────────────────────────────────
# XAMPP default MySQL configuration (no password for root)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lei
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PORT=3306
DATABASE_URL="mysql://root:@127.0.0.1:3306/lei"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_48_byte_random_string
JWT_REFRESH_SECRET=replace_with_a_different_48_byte_random_string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── File storage (local VPS for MVP; outside the web root) ──────────────────
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=10485760

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
