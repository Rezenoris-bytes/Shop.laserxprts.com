{
  "name": "@lei/api",
  "version": "0.1.0",
  "private": true,
  "description": "LEI backend — NestJS + Fastify modular monolith",
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "ts-node --transpile-only prisma/seed/index.ts",
    "db:purge-seed": "ts-node --transpile-only prisma/seed/purge.ts",
    "db:import-reference": "ts-node --transpile-only prisma/seed/import-reference.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@lei/shared": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "//optionalDependencies": "sharp ships its native binding as per-OS optional packages. The Hostinger build host was not resolving them, leaving the app to crash on boot with 'Could not load the sharp module using the linux-x64 runtime'. Declaring the linux-x64 pair explicitly forces npm to install them there; both carry os/cpu constraints so npm skips them on Windows/macOS dev machines.",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@lei/shared$": "<rootDir>/../../packages/shared-types/src/index.ts",
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
