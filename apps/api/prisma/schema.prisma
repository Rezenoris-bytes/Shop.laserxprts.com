enum Locale {
  en
  hi
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  VARIANT_VIEW
  CATEGORY_VIEW
  SERVICE_VIEW
  SEARCH
  SEARCH_NO_RESULTS
  FILTER_USED
  COMPATIBILITY_SEARCH
  QUOTE_REQUEST_START
  QUOTE_REQUEST_ITEM_ADDED
  QUOTE_REQUEST_ITEM_REMOVED
  QUOTE_REQUEST_SUBMIT
  BROCHURE_DOWNLOAD
  WHATSAPP_CLICK
  PHONE_CLICK
